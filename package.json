{
  "name": "hypo.md",
  "version": "1.0.0",
  "description": "Lightweight self-hosted Markdown notes server with wiki links, syntax highlighting and Mermaid diagrams.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "markdown",
    "notes",
    "wiki",
    "obsidian",
    "express",
    "mermaid",
    "highlight.js"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^5.2.1",
    "highlight.js": "^11.12.0",
    "marked": "^12.0.2"
  }
}
